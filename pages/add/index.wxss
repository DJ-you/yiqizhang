.type-switch { display: flex; background: #eceef1; border-radius: 18rpx; padding: 6rpx; margin-bottom: 20rpx; }.type-item { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 14rpx; color: #7b8088; font-weight: 650; }.type-item.active { background: #fff; color: #17191d; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.05); }.amount-card { padding: 34rpx; }.amount-label { font-size: 24rpx; }.amount-input-wrap { display: flex; align-items: baseline; margin-top: 18rpx; }.currency { font-size: 38rpx; font-weight: 700; margin-right: 12rpx; }.amount-input { height: 86rpx; flex: 1; font-size: 68rpx; font-weight: 750; letter-spacing: -2rpx; }.category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }.category-item { text-align: center; padding: 18rpx 6rpx; border-radius: 20rpx; color: #666b73; font-size: 23rpx; }.category-icon { width: 66rpx; height: 66rpx; border-radius: 20rpx; margin: 0 auto 12rpx; background: #f1f2f4; display: flex; align-items: center; justify-content: center; }.category-item.selected { background: #f3f6ff; color: #275fcf; font-weight: 650; }.category-item.selected .category-icon { background: #dfe9ff; color: #275fcf; }.form-card { padding-top: 4rpx; padding-bottom: 4rpx; }.form-row { display: flex; align-items: center; padding: 25rpx 0; }.form-row + .form-row { border-top: 1rpx solid #f0f1f3; }.form-label { width: 100rpx; font-weight: 650; }.form-value { color: #686d75; }.note-input { flex: 1; text-align: right; }.save-btn { margin-top: 36rpx; height: 92rpx; line-height: 92rpx; display: flex; align-items: center; justify-content: center; }
