<view class="container"><view class="section-title">创建共享账本</view><view class="card create-card"><input class="ledger-input" value="{{name}}" bindinput="onName" placeholder="例如：周末旅行、合租开销" /><button class="primary-btn create-btn" bindtap="createLedger">创建账本</button></view><view class="section-title">我的共享账本</view><block wx:if="{{ledgers.length}}"><view wx:for="{{ledgers}}" wx:key="id" class="card ledger-card" data-id="{{item.id}}" bindtap="openLedger"><view class="ledger-top"><view class="ledger-name">{{item.name}}</view><view class="ledger-arrow">›</view></view><view class="muted small">{{item.memberCount}} 人 · {{item.billCount}} 笔账单</view><view class="ledger-total">¥{{item.total}}</view></view></block><view wx:else class="empty">还没有共享账本</view></view>
