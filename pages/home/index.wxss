.hero { background: linear-gradient(145deg, #181b20 0%, #30343b 100%); color: #fff; padding: 34rpx; }
.hero-top { display: flex; justify-content: space-between; align-items: flex-start; }.eyebrow { color: rgba(255,255,255,.62); font-size: 23rpx; margin-bottom: 24rpx; }.hero-label { color: rgba(255,255,255,.76); font-size: 25rpx; }.hero-amount { font-size: 64rpx; font-weight: 750; letter-spacing: -2rpx; margin-top: 8rpx; }
.month-switch { display: flex; align-items: center; background: rgba(255,255,255,.12); border-radius: 999rpx; overflow: hidden; }.month-arrow { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: rgba(255,255,255,.86); }.month-label { min-width: 126rpx; text-align: center; font-size: 23rpx; }
.hero-stats { display: flex; align-items: center; margin-top: 42rpx; padding-top: 26rpx; border-top: 1rpx solid rgba(255,255,255,.12); }.hero-stat { flex: 1; }.stat-label { color: rgba(255,255,255,.58); font-size: 23rpx; }.stat-value { margin-top: 8rpx; font-size: 30rpx; font-weight: 650; }.divider { width: 1rpx; height: 52rpx; background: rgba(255,255,255,.13); margin: 0 32rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 20rpx; }.quick { display: flex; align-items: center; padding: 24rpx; }.quick-icon { width: 66rpx; height: 66rpx; border-radius: 20rpx; background: #eef5ff; color: #356fea; display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin-right: 18rpx; }.quick-icon.people { background: #f1f8f4; color: #2d8b62; }.quick-title { font-size: 27rpx; font-weight: 700; }.quick-desc { font-size: 20rpx; color: #979ba3; margin-top: 6rpx; }
.category-row { display: flex; align-items: center; padding: 18rpx 0; }.category-row + .category-row { border-top: 1rpx solid #f1f2f4; }.category-main { flex: 1; margin-right: 30rpx; }.category-name { font-size: 26rpx; font-weight: 600; }.category-track { height: 8rpx; background: #f0f1f3; border-radius: 999rpx; margin-top: 13rpx; overflow: hidden; }.category-bar { height: 100%; background: #20242a; border-radius: 999rpx; min-width: 8rpx; }.category-right { min-width: 128rpx; text-align: right; font-weight: 600; }.small { font-size: 21rpx; font-weight: 400; margin-top: 4rpx; }.compact { padding: 28rpx 16rpx; }.recent-card { padding-top: 10rpx; padding-bottom: 10rpx; }.transaction-row { display: flex; align-items: center; padding: 20rpx 0; }.transaction-row + .transaction-row { border-top: 1rpx solid #f1f2f4; }.transaction-icon { width: 64rpx; height: 64rpx; border-radius: 20rpx; background: #f1f2f4; display: flex; align-items: center; justify-content: center; margin-right: 18rpx; }.transaction-info { flex: 1; min-width: 0; }.transaction-title { font-size: 27rpx; font-weight: 650; margin-bottom: 6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.transaction-amount { font-size: 27rpx; font-weight: 700; margin-left: 20rpx; }
.home-entry-card { margin: 24rpx; padding: 28rpx; background: #fff; border-radius: 24rpx; display: flex; align-items: center; gap: 16rpx; font-size: 32rpx; }.entry-icon { font-size: 42rpx; }
