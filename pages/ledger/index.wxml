<view class="container" wx:if="{{ledger}}"><view class="card ledger-hero"><view class="ledger-name">{{ledger.name}}</view><view class="hero-number">¥{{total}}</view><view class="muted small">未结算 ¥{{unsettled}}</view></view><view class="section-title">成员</view><view class="card member-card"><view wx:for="{{ledger.members}}" wx:key="id" class="member-pill">{{item.name}}</view><view class="member-add" bindtap="startMember">＋ 添加成员</view><view wx:if="{{addingMember}}" class="inline-form"><input value="{{memberName}}" bindinput="onMemberName" placeholder="成员名称" /><button class="secondary-btn mini-btn" bindtap="cancelMember">取消</button><button class="primary-btn mini-btn" bindtap="saveMember">保存</button></view></view><view class="section-title bill-title-row"><text>共同消费</text><button class="primary-btn mini-btn" bindtap="startBill">＋ 记账</button></view><view wx:if="{{addingBill}}" class="card bill-form"><view class="form-row"><text>金额</text><input type="digit" value="{{amount}}" bindinput="onAmount" placeholder="0.00" /></view><view class="form-row"><text>备注</text><input value="{{note}}" bindinput="onNote" placeholder="例如：晚餐" /></view><view class="form-label">付款人</view><view class="choice-row"><view wx:for="{{ledger.members}}" wx:key="id" class="choice {{payerId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="choosePayer">{{item.name}}</view></view><view class="form-label">参与分摊</view><view class="choice-row"><view wx:for="{{membersForBill}}" wx:key="id" class="choice {{participantIds.indexOf(item.id) >= 0 ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleParticipant">{{item.name}}</view></view><view class="form-label">分类</view><view class="choice-row"><view wx:for="{{categories}}" wx:key="key" class="choice {{category === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="chooseCategory">{{item.icon}} {{item.label}}</view></view><view class="form-actions"><button class="secondary-btn" bindtap="cancelBill">取消</button><button class="primary-btn" bindtap="saveBill">保存账单</button></view></view><block wx:if="{{displayBills.length}}"><view wx:for="{{displayBills}}" wx:key="id" class="card bill-card" data-id="{{item.id}}" bindlongpress="deleteBill"><view class="bill-top"><text class="bill-note">{{item.note || '共同消费'}}</text><text>¥{{item.amountText}}</text></view><view class="muted small">{{item.payerName}} 付款 · {{item.participantNames}}</view></view></block><view wx:else class="empty">还没有共同消费记录</view><button class="primary-btn settlement-btn" bindtap="goSettlement">查看自动结算方案</button></view>
