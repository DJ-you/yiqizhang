.ledger-hero { background: linear-gradient(145deg, #f8eee6 0%, #fff 75%); }.ledger-name { font-size: 34rpx; font-weight: 700; }.hero-number { margin-top: 24rpx; font-size: 56rpx; font-weight: 750; }.member-card { display: flex; flex-wrap: wrap; gap: 14rpx; }.member-pill, .member-add, .choice { padding: 12rpx 18rpx; border-radius: 999rpx; background: #f1f2f4; color: #575c65; }.member-add { background: #eef5ff; color: #356fea; }.inline-form { width: 100%; display: flex; align-items: center; gap: 10rpx; padding-top: 16rpx; }.inline-form input { flex: 1; height: 72rpx; border-bottom: 1rpx solid #ddd; }.mini-btn { height: 68rpx; line-height: 68rpx; padding: 0 22rpx; font-size: 24rpx; }.bill-title-row { display: flex; align-items: center; justify-content: space-between; }.bill-form { margin-bottom: 18rpx; }.form-row { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f1f2f4; }.form-row text { width: 120rpx; }.form-row input { flex: 1; text-align: right; }.form-label { margin-top: 20rpx; font-size: 24rpx; font-weight: 650; }.choice-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }.choice.selected { background: #dfe9ff; color: #275fcf; }.form-actions { display: flex; gap: 18rpx; margin-top: 24rpx; }.form-actions button { flex: 1; }.bill-card { margin-top: 16rpx; }.bill-top { display: flex; justify-content: space-between; font-size: 28rpx; font-weight: 650; }.settlement-btn { margin-top: 28rpx; }
