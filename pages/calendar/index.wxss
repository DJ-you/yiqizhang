.month-nav-card { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 20rpx; }.month-arrow { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: #24272d; font-size: 38rpx; }.month-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 700; }.calendar-card { margin-top: 20rpx; padding: 20rpx; }.week-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }.weekday { color: #a2a6ad; font-size: 23rpx; text-align: center; padding: 8rpx 0; }.calendar-grid { margin-top: 8rpx; }.day { min-width: 0; min-height: 106rpx; box-sizing: border-box; padding: 10rpx 6rpx; background: #f7f8fa; border-radius: 14rpx; }.day-blank { background: transparent; }.day-number { color: #24272d; font-size: 26rpx; font-weight: 650; }.day-amount { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-top: 7rpx; font-size: 18rpx; line-height: 1.2; }.expense { color: #d9534f; }.income { color: #2a9d55; }.detail-card { margin-top: 20rpx; }.detail-title { font-size: 30rpx; font-weight: 700; padding-bottom: 18rpx; }.detail-section + .detail-section { border-top: 1rpx solid #f0f1f3; margin-top: 12rpx; padding-top: 12rpx; }.detail-section-title { font-size: 24rpx; font-weight: 650; margin-bottom: 4rpx; }.detail-row { display: flex; align-items: center; padding: 16rpx 0; }.detail-row + .detail-row { border-top: 1rpx solid #f1f2f4; }.detail-icon { width: 56rpx; height: 56rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; background: #f1f2f4; margin-right: 16rpx; }.detail-info { flex: 1; min-width: 0; }.detail-note { font-size: 27rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.detail-amount { margin-left: 16rpx; font-size: 26rpx; font-weight: 650; }
