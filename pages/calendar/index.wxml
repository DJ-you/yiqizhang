<view class="container"><view class="card month-nav-card"><view class="month-arrow" data-offset="-1" bindtap="changeMonth">←</view><view class="month-title">{{monthLabel}}</view><view class="month-arrow" data-offset="1" bindtap="changeMonth">→</view></view><view class="card calendar-card"><view class="week-row"><view wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</view></view><view class="calendar-grid"><view wx:for="{{calendarCells}}" wx:key="key" class="day {{item.isBlank ? 'day-blank' : ''}}" data-date="{{item.date}}" bindtap="selectDay"><block wx:if="{{!item.isBlank}}"><view class="day-number">{{item.day}}</view><view class="day-amount expense" wx:if="{{item.expense}}">支 ¥{{item.expense}}</view><view class="day-amount income" wx:if="{{item.income}}">收 ¥{{item.income}}</view></block></view></view></view><view wx:if="{{selectedDate}}" class="card detail-card"><view class="detail-title">{{selectedDate}}</view><view wx:if="{{selectedExpenses.length}}" class="detail-section"><view class="detail-section-title expense">支出</view><view wx:for="{{selectedExpenses}}" wx:key="id" class="detail-row"><view class="detail-icon">{{item.iconText}}</view><view class="detail-info"><view class="detail-note">{{item.note || item.categoryLabel}}</view><view class="muted small">{{item.categoryLabel}}</view></view><view class="detail-amount expense">{{item.amountText}}</view></view></view><view wx:if="{{selectedIncomes.length}}" class="detail-section"><view class="detail-section-title income">收入</view><view wx:for="{{selectedIncomes}}" wx:key="id" class="detail-row"><view class="detail-icon">{{item.iconText}}</view><view class="detail-info"><view class="detail-note">{{item.note || item.categoryLabel}}</view><view class="muted small">{{item.categoryLabel}}</view></view><view class="detail-amount income">{{item.amountText}}</view></view></view><view wx:if="{{!selectedExpenses.length && !selectedIncomes.length}}" class="empty compact">当天没有账单</view></view></view>
