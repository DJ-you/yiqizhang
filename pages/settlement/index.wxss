.settlement-hero { background: linear-gradient(145deg, #f8eee6 0%, #fff 75%); border: 1rpx solid #f1dfd1; }.hero-number { margin-top: 24rpx; font-size: 58rpx; font-weight: 750; }.stat-row { display: flex; align-items: center; padding: 20rpx 0; }.stat-row + .stat-row { border-top: 1rpx solid #f1f2f4; }.stat-member { width: 120rpx; font-weight: 650; }.stat-row .small { flex: 1; }.stat-balance { margin-left: 12rpx; font-weight: 700; }.transfer-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; }.transfer-row + .transfer-row { border-top: 1rpx solid #f1f2f4; }.transfer-amount { font-size: 30rpx; font-weight: 700; color: #b65e2c; }
