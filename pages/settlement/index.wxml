<view class="container" wx:if="{{ledger}}"><view class="settlement-hero card"><view class="muted">{{ledger.name}} · 自动结算</view><view class="hero-number">¥{{totalTransfer}}</view><view class="muted small">需要转账的总额</view></view><view class="section-title">成员结余</view><view class="card"><view wx:for="{{stats}}" wx:key="member.id" class="stat-row"><view class="stat-member">{{item.member.name}}</view><view class="muted small">实付 ¥{{item.paid}} · 应付 ¥{{item.owed}}</view><view class="stat-balance {{item.balance.indexOf('+') === 0 ? 'amount-income' : 'amount-expense'}}">{{item.balance}}</view></view></view><view class="section-title">转账方案</view><view class="card"><block wx:if="{{transfers.length}}"><view wx:for="{{transfers}}" wx:key="fromId" class="transfer-row"><view>{{item.fromName}} → {{item.toName}}</view><view class="transfer-amount">¥{{item.amount}}</view></view></block><view wx:else class="empty compact">账本已经结清</view></view></view>
